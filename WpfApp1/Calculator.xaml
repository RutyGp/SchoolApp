<Window x:Class="WpfApp1.Calculator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Calculator" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <Button Content="start the game" Click="Start" Width="40" Height="40"/>
            <Border BorderBrush="Pink" Background="PaleGoldenrod" BorderThickness="1">
            <StackPanel Orientation="Horizontal" x:Name="sp">
                <Border BorderBrush="Black" BorderThickness="1" Width="40" Height="40">
                    <TextBlock x:Name="num1" Width="40" Height="40"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Width="40" Height="40">
                    <TextBlock x:Name="action1" Width="40" Height="40"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Width="40" Height="40">
                    <TextBlock x:Name="num2" Width="40" Height="40"/>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Width="100" Height="40">
                    <TextBox x:Name="answer" Width="100" Height="40"/>
                </Border>
                <Button Content="V" Click="Check"/>
                <TextBlock x:Name="result" Width="40" Height="40"/>
            </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
